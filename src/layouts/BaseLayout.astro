---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { BookOpen, GitFork, ListChecks, Plus, Settings } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '算法题库',
  description = '个人算法题目总结与复习题库',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base}>
          <span class="brand-icon"><BookOpen size={19} stroke-width={2.2} /></span>
          <span>算法题库</span>
        </a>
        <nav class="header-actions" aria-label="题库操作">
          <a
            class="icon-link"
            href="https://github.com/wwwfq/question-bank"
            target="_blank"
            rel="noreferrer"
            aria-label="打开 GitHub 仓库"
            title="打开 GitHub 仓库"
          >
            <GitFork size={18} />
          </a>
          <a
            class="outline-button"
            href={`${base}list/`}
            aria-label="题单"
            title="题单"
          >
            <ListChecks size={17} />
            <span>题单</span>
          </a>
          <a
            class="outline-button"
            href={`${base}admin/`}
          >
            <Settings size={17} />
            <span>管理题库</span>
          </a>
          <a
            class="primary-button"
            href={`${base}admin/?new=1`}
          >
            <Plus size={17} />
            <span>录入题目</span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>题目数据由 Supabase 实时同步</span>
        <a href={`${base}admin/`}>管理题库</a>
      </div>
    </footer>
  </body>
</html>

