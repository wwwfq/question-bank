---
import BaseLayout from '../layouts/BaseLayout.astro';
import { questions, sources, difficulties, levels, allTags } from '../lib/questions';
import { renderRichText } from '../lib/markdown';
import {
  BookMarked,
  ChevronRight,
  Filter,
  Search,
  Tag,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="workspace">
    <div class="page-heading">
      <div>
        <p class="eyebrow">个人知识库</p>
        <h1>算法题库</h1>
        <p class="page-description">整理和检索合适的题目、解题思路与算法标签。</p>
      </div>
      <div class="stats" aria-label="题库统计">
        <div class="stat">
          <BookMarked size={18} />
          <div><strong>{questions.length}</strong><span>收录题目</span></div>
        </div>
        <div class="stat">
          <Filter size={18} />
          <div><strong>{sources.length}</strong><span>题目来源</span></div>
        </div>
        <div class="stat">
          <Tag size={18} />
          <div><strong>{allTags.length}</strong><span>题目标签</span></div>
        </div>
      </div>
    </div>

    <div class="filter-bar">
      <label class="search-box">
        <Search size={18} />
        <span class="sr-only">搜索题目</span>
        <input id="search" type="search" placeholder="搜索题目、分类或标签" autocomplete="off" />
      </label>
      <div class="select-wrap">
        <Filter size={16} />
        <select id="source-filter" aria-label="按来源筛选">
          <option value="">全部来源</option>
          {sources.map((source) => <option value={source}>{source}</option>)}
        </select>
      </div>
      <div class="select-wrap">
        <select id="difficulty-filter" aria-label="按难度筛选">
          <option value="">全部难度</option>
          {difficulties.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}
        </select>
      </div>
      <div class="select-wrap">
        <select id="level-filter" aria-label="按适用级别筛选">
          <option value="">全部级别</option>
          {levels.map((level) => <option value={level}>{level}</option>)}
        </select>
      </div>
      <div class="select-wrap">
        <Tag size={16} />
        <select id="tag-filter" aria-label="按标签筛选">
          <option value="">全部标签</option>
          {allTags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
      </div>
    </div>

    <div class="list-header">
      <span id="result-count">共 {questions.length} 道题</span>
      <span>按收录时间排序</span>
    </div>

    <div class="question-list" id="question-list">
      {
        questions.map((question) => (
          <a
            class="question-row"
            href={`${base}questions/${question.slug}/`}
            data-search={`${question.title} ${question.statement} ${question.summary} ${question.source} ${question.levels.join(' ')} ${question.categories.join(' ')} ${question.tags.join(' ')}`.toLowerCase()}
            data-source={question.sourceValues.join('|')}
            data-difficulty={question.difficultyValues.join('|')}
            data-levels={question.levels.join('|')}
            data-tags={question.tags.join('|')}
          >
            <div class="question-main">
              <div class="question-title-line">
                <h2>{question.title}</h2>
                {question.sourceId && <span class="source-id">#{question.sourceId}</span>}
              </div>
              {
                (question.statement || question.summary) && (
                  <div
                    class="question-summary"
                    set:html={renderRichText(question.statement || question.summary)}
                  />
                )
              }
              <div class="tag-list">
                {question.levels.map((level) => <span class="level-chip">{level}</span>)}
                {question.categories.map((category) => <span class="category-chip">{category}</span>)}
                {question.tags.slice(0, 4).map((tag) => <span class="tag-chip">{tag}</span>)}
              </div>
            </div>
            <div class="question-meta">
              <span class={`difficulty difficulty-${question.difficulty}`}>{question.difficulty}</span>
              <span>{question.source}</span>
              <ChevronRight class="row-arrow" size={18} />
            </div>
          </a>
        ))
      }
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <Search size={28} />
      <strong>没有找到匹配的题目</strong>
      <span>可以清空搜索条件后再试。</span>
    </div>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#search');
    const sourceFilter = document.querySelector<HTMLSelectElement>('#source-filter');
    const difficultyFilter = document.querySelector<HTMLSelectElement>('#difficulty-filter');
    const levelFilter = document.querySelector<HTMLSelectElement>('#level-filter');
    const tagFilter = document.querySelector<HTMLSelectElement>('#tag-filter');
    const rows = [...document.querySelectorAll<HTMLElement>('.question-row')];
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const emptyState = document.querySelector<HTMLElement>('#empty-state');

    function updateResults() {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      const source = sourceFilter?.value ?? '';
      const difficulty = difficultyFilter?.value ?? '';
      const level = levelFilter?.value ?? '';
      const tag = tagFilter?.value ?? '';
      let visibleCount = 0;

      rows.forEach((row) => {
        const matchesSearch = !query || row.dataset.search?.includes(query);
        const matchesSource = !source || row.dataset.source?.split('|').includes(source);
        const matchesDifficulty =
          !difficulty || row.dataset.difficulty?.split('|').includes(difficulty);
        const matchesLevel = !level || row.dataset.levels?.split('|').includes(level);
        const matchesTag = !tag || row.dataset.tags?.split('|').includes(tag);
        const visible = Boolean(
          matchesSearch && matchesSource && matchesDifficulty && matchesLevel && matchesTag,
        );
        row.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (resultCount) resultCount.textContent = `共 ${visibleCount} 道题`;
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    searchInput?.addEventListener('input', updateResults);
    sourceFilter?.addEventListener('change', updateResults);
    difficultyFilter?.addEventListener('change', updateResults);
    levelFilter?.addEventListener('change', updateResults);
    tagFilter?.addEventListener('change', updateResults);
  </script>
</BaseLayout>
