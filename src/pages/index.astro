---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ArrowUpDown,
  BookMarked,
  CalendarRange,
  ChevronDown,
  Filter,
  RotateCcw,
  Search,
  SlidersHorizontal,
  Tag,
} from '@lucide/astro';
import {
  difficultyOptions,
  levelOptions,
  sourceOptions,
  tagGroups,
} from '../lib/options';

const ratingOptions = difficultyOptions
  .filter((value) => value.startsWith('*'))
  .map((value) => value.slice(1));
---

<BaseLayout>
  <section class="workspace">
    <div class="page-heading">
      <div>
        <p class="eyebrow">个人知识库</p>
        <h1>算法题库</h1>
        <p class="page-description">整理和检索合适的题目、解题思路与算法标签。</p>
      </div>
      <div class="stats" aria-label="题库统计">
        <div class="stat">
          <BookMarked size={18} />
          <div><strong id="question-count">-</strong><span>收录题目</span></div>
        </div>
        <div class="stat">
          <Filter size={18} />
          <div><strong id="source-count">-</strong><span>题目来源</span></div>
        </div>
        <div class="stat">
          <Tag size={18} />
          <div><strong id="tag-count">-</strong><span>题目标签</span></div>
        </div>
      </div>
    </div>

    <div class="filter-bar">
      <div class="filter-primary">
        <label class="search-box">
          <Search size={18} />
          <span class="sr-only">搜索题目</span>
          <input id="search" type="search" placeholder="搜索标题、题意、解题思路、来源、级别或标签" autocomplete="off" />
        </label>
        <label class="sort-box">
          <ArrowUpDown size={16} />
          <span class="sr-only">排序方式</span>
          <select id="sort-filter" aria-label="排序方式">
            <option value="newest">最新收录</option>
            <option value="oldest">最早收录</option>
            <option value="difficulty-asc">难度从低到高</option>
            <option value="difficulty-desc">难度从高到低</option>
            <option value="source-asc">来源 A-Z</option>
            <option value="source-desc">来源 Z-A</option>
          </select>
        </label>
      </div>

      <div class="scope-row">
        <span class="filter-label">搜索范围</span>
        <label class="check-chip scope-chip">
          <input type="checkbox" data-scope="title" checked />
          <span>标题</span>
        </label>
        <label class="check-chip scope-chip">
          <input type="checkbox" data-scope="statement" checked />
          <span>题意</span>
        </label>
        <label class="check-chip scope-chip">
          <input type="checkbox" data-scope="solution" checked />
          <span>解题思路</span>
        </label>
      </div>

      <div class="facet-grid">
        <details class="filter-menu" data-menu="source">
          <summary>
            <SlidersHorizontal size={15} />
            <span class="filter-menu-name">来源</span>
            <span class="filter-menu-value" data-menu-summary="source">全部来源</span>
            <ChevronDown size={16} class="menu-chevron" />
          </summary>
          <div class="filter-menu-panel">
            <label class="menu-search">
              <Search size={14} />
              <input type="search" data-menu-search="source" placeholder="搜索来源" autocomplete="off" />
            </label>
            <div class="menu-options" data-menu-options="source">
              {sourceOptions.map((source) => (
                <label class="check-chip menu-chip">
                  <input type="checkbox" data-facet="source" value={source} />
                  <span>{source}</span>
                </label>
              ))}
            </div>
          </div>
        </details>

        <details class="filter-menu" data-menu="difficulty">
          <summary>
            <Filter size={15} />
            <span class="filter-menu-name">难度</span>
            <span class="filter-menu-value" data-menu-summary="difficulty">全部难度</span>
            <ChevronDown size={16} class="menu-chevron" />
          </summary>
          <div class="filter-menu-panel">
            <label class="menu-search">
              <Search size={14} />
              <input type="search" data-menu-search="difficulty" placeholder="搜索难度" autocomplete="off" />
            </label>
            <div class="menu-options" data-menu-options="difficulty">
              {difficultyOptions.map((difficulty) => (
                <label class="check-chip menu-chip">
                  <input type="checkbox" data-facet="difficulty" value={difficulty} />
                  <span>{difficulty}</span>
                </label>
              ))}
            </div>
          </div>
        </details>

        <details class="filter-menu" data-menu="level">
          <summary>
            <Filter size={15} />
            <span class="filter-menu-name">级别</span>
            <span class="filter-menu-value" data-menu-summary="level">全部级别</span>
            <ChevronDown size={16} class="menu-chevron" />
          </summary>
          <div class="filter-menu-panel">
            <label class="menu-search">
              <Search size={14} />
              <input type="search" data-menu-search="level" placeholder="搜索级别" autocomplete="off" />
            </label>
            <div class="menu-options" data-menu-options="level">
              {levelOptions.map((level) => (
                <label class="check-chip menu-chip">
                  <input type="checkbox" data-facet="level" value={level} />
                  <span>{level}</span>
                </label>
              ))}
            </div>
          </div>
        </details>

        <details class="filter-menu" data-menu="tag">
          <summary>
            <Tag size={15} />
            <span class="filter-menu-name">标签</span>
            <span class="filter-menu-value" data-menu-summary="tag">全部标签</span>
            <ChevronDown size={16} class="menu-chevron" />
          </summary>
          <div class="filter-menu-panel">
            <label class="menu-search">
              <Search size={14} />
              <input type="search" data-menu-search="tag" placeholder="搜索标签" autocomplete="off" />
            </label>
            <div class="segmented menu-mode" role="group" aria-label="标签组合逻辑">
              <label class="segment">
                <input type="radio" name="tag-match" value="all" />
                <span>全部满足</span>
              </label>
              <label class="segment">
                <input type="radio" name="tag-match" value="any" checked />
                <span>任一满足</span>
              </label>
            </div>
            <div class="menu-options" data-menu-options="tag">
              {tagGroups.map((group) => (
                <section class="menu-group">
                  <h3 class="menu-group-title">{group.label}</h3>
                  <div class="menu-group-options">
                    {group.tags.map((tag) => (
                      <label class="check-chip menu-chip">
                        <input type="checkbox" data-facet="tag" value={tag} />
                        <span>{tag}</span>
                      </label>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </details>
      </div>

      <div class="range-row">
        <fieldset class="range-field">
          <legend class="filter-label"><CalendarRange size={14} />Rating</legend>
          <div class="range-controls">
            <select id="rating-min" aria-label="最低 Rating">
              <option value="">最低</option>
              {ratingOptions.map((value) => <option value={value}>*{value}</option>)}
            </select>
            <span class="range-separator">—</span>
            <select id="rating-max" aria-label="最高 Rating">
              <option value="">最高</option>
              {ratingOptions.map((value) => <option value={value}>*{value}</option>)}
            </select>
          </div>
        </fieldset>
      </div>

      <div class="filter-footer">
        <button class="clear-button" id="clear-filters" type="button">
          <RotateCcw size={15} />
          <span>清空筛选</span>
        </button>
      </div>
    </div>

    <div class="list-header">
      <span id="result-count">正在加载题目...</span>
      <span id="sort-label">按最新收录排序</span>
    </div>

    <div class="question-list" id="question-list" aria-live="polite"></div>

    <div class="empty-state" id="empty-state" hidden>
      <Search size={28} />
      <strong>没有找到匹配的题目</strong>
      <span>可以清空搜索条件后再试。</span>
    </div>

    <div class="empty-state" id="load-error" hidden>
      <strong>题库暂时无法加载</strong>
      <button class="outline-button" id="retry-button" type="button">重新加载</button>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';
    import { primaryValue, type Question } from '../lib/questions';
    import { difficultyOptions } from '../lib/options';
    import { renderRichText } from '../lib/markdown';

    type Facet = 'source' | 'difficulty' | 'level' | 'tag';
    type SearchField = 'title' | 'statement' | 'solution' | 'source' | 'level' | 'tag' | 'difficulty';
    type MatchMode = 'all' | 'any';
    type SortMode = 'newest' | 'oldest' | 'difficulty-asc' | 'difficulty-desc' | 'source-asc' | 'source-desc';
    type QuestionWithExcerpt = Question & { solutionExcerptHtml: string };

    const base = import.meta.env.BASE_URL;
    const searchInput = document.querySelector<HTMLInputElement>('#search');
    const sortFilter = document.querySelector<HTMLSelectElement>('#sort-filter');
    const sortLabel = document.querySelector<HTMLElement>('#sort-label');
    const ratingMin = document.querySelector<HTMLSelectElement>('#rating-min');
    const ratingMax = document.querySelector<HTMLSelectElement>('#rating-max');
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-filters');
    const questionList = document.querySelector<HTMLElement>('#question-list');
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const emptyState = document.querySelector<HTMLElement>('#empty-state');
    const loadError = document.querySelector<HTMLElement>('#load-error');
    const retryButton = document.querySelector<HTMLButtonElement>('#retry-button');
    const scopeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-scope]'));
    const facetInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-facet]'));
    const tagMatchInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="tag-match"]'));
    const menuSearchInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-menu-search]'));
    let questions: QuestionWithExcerpt[] = [];
    let searchTimer: number | undefined;
    const scrollStorageKey = 'question-bank:index-scroll:v1';
    let scrollRestored = false;

    const facetSummaryLabels: Record<Facet, string> = {
      source: '全部来源',
      difficulty: '全部难度',
      level: '全部级别',
      tag: '全部标签',
    };

    const fieldAliases: Record<string, SearchField> = {
      title: 'title',
      标题: 'title',
      statement: 'statement',
      题意: 'statement',
      solution: 'solution',
      思路: 'solution',
      解题思路: 'solution',
      source: 'source',
      来源: 'source',
      level: 'level',
      级别: 'level',
      tag: 'tag',
      标签: 'tag',
      difficulty: 'difficulty',
      难度: 'difficulty',
    };

    const sortLabels: Record<SortMode, string> = {
      newest: '按最新收录排序',
      oldest: '按最早收录排序',
      'difficulty-asc': '按难度从低到高排序',
      'difficulty-desc': '按难度从高到低排序',
      'source-asc': '按来源 A-Z 排序',
      'source-desc': '按来源 Z-A 排序',
    };

    const sortModes = new Set<SortMode>([
      'newest',
      'oldest',
      'difficulty-asc',
      'difficulty-desc',
      'source-asc',
      'source-desc',
    ]);

    function isSortMode(value: string): value is SortMode {
      return sortModes.has(value as SortMode);
    }

    function appendChip(container: HTMLElement, text: string, className: string) {
      const chip = document.createElement('span');
      chip.className = className;
      chip.textContent = text;
      container.append(chip);
    }

    function excerptHtml(markdown: string): string {
      const node = document.createElement('div');
      node.innerHTML = renderRichText(markdown);
      const blocks = Array.from(node.querySelectorAll('p, li, h1, h2, h3, h4, blockquote, td, th, pre'));
      const firstBlock = blocks.find((block) => block.textContent?.trim());
      const source = firstBlock ?? node;
      return source.innerHTML.trim();
    }

    function buildQuestionRow(question: Question) {
      const row = document.createElement('a');
      row.className = 'question-row';
      row.href = `${base}question/?id=${encodeURIComponent(question.id)}`;

      const main = document.createElement('div');
      main.className = 'question-main';
      const titleLine = document.createElement('div');
      titleLine.className = 'question-title-line';
      const title = document.createElement('h2');
      title.textContent = question.title;
      titleLine.append(title);
      main.append(titleLine);

      if (question.solutionExcerptHtml) {
        const solutionPreview = document.createElement('p');
        solutionPreview.className = 'question-solution-preview';
        solutionPreview.innerHTML = question.solutionExcerptHtml;
        main.append(solutionPreview);
      }

      const meta = document.createElement('div');
      meta.className = 'question-meta';
      const difficulty = document.createElement('span');
      difficulty.className = 'difficulty';
      difficulty.textContent = primaryValue(question.difficulties, '未分类');
      const arrow = document.createElement('span');
      arrow.className = 'row-arrow';
      arrow.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
      meta.append(difficulty);
      question.levels.forEach((value) => appendChip(meta, value, 'level-chip'));
      question.tags.forEach((value) => appendChip(meta, value, 'tag-chip'));
      meta.append(arrow);
      row.append(main, meta);
      return row;
    }

    function updateStats() {
      const sources = new Set(questions.flatMap((question) => question.sources));
      const tags = new Set(questions.flatMap((question) => question.tags));
      const questionCount = document.querySelector<HTMLElement>('#question-count');
      const sourceCount = document.querySelector<HTMLElement>('#source-count');
      const tagCount = document.querySelector<HTMLElement>('#tag-count');
      if (questionCount) questionCount.textContent = String(questions.length);
      if (sourceCount) sourceCount.textContent = String(sources.size);
      if (tagCount) tagCount.textContent = String(tags.size);
    }

    function getSelectedValues(facet: string): string[] {
      return Array.from(document.querySelectorAll<HTMLInputElement>(`[data-facet="${facet}"]`))
        .filter((input) => input.checked)
        .map((input) => input.value);
    }

    function getTagMatchMode(): MatchMode {
      return document.querySelector<HTMLInputElement>('input[name="tag-match"]:checked')?.value === 'all'
        ? 'all'
        : 'any';
    }

    function setFacetValues(facet: Facet, values: string[]) {
      facetInputs
        .filter((input) => input.dataset.facet === facet)
        .forEach((input) => {
          input.checked = values.includes(input.value);
        });
    }

    function applyUrlState() {
      const params = new URLSearchParams(window.location.search);

      const query = params.get('q');
      if (searchInput && query !== null) searchInput.value = query;

      const sort = params.get('sort');
      if (sortFilter && sort && isSortMode(sort)) sortFilter.value = sort;

      const scope = params.get('scope');
      if (scope !== null) {
        const selectedScopes = scope.split(',').filter(Boolean);
        scopeInputs.forEach((input) => {
          const scopeName = input.dataset.scope ?? '';
          input.checked = selectedScopes.includes(scopeName);
        });
      }

      setFacetValues('source', params.getAll('source'));
      setFacetValues('difficulty', params.getAll('difficulty'));
      setFacetValues('level', params.getAll('level'));
      setFacetValues('tag', params.getAll('tag'));

      const tagMatch = params.get('tag-match');
      tagMatchInputs.forEach((input) => {
        input.checked = tagMatch === 'all' ? input.value === 'all' : input.value === 'any';
      });

      const minRating = params.get('rating-min');
      const maxRating = params.get('rating-max');
      if (ratingMin && minRating !== null) ratingMin.value = minRating;
      if (ratingMax && maxRating !== null) ratingMax.value = maxRating;
    }

    function syncUrlState() {
      const params = new URLSearchParams();
      const query = searchInput?.value.trim() ?? '';
      if (query) params.set('q', query);

      const sort = sortFilter?.value ?? 'newest';
      if (isSortMode(sort) && sort !== 'newest') params.set('sort', sort);

      const scopes = scopeInputs
        .filter((input) => input.checked)
        .map((input) => input.dataset.scope ?? '')
        .filter(Boolean);
      if (scopes.length !== scopeInputs.length) params.set('scope', scopes.join(','));

      (['source', 'difficulty', 'level', 'tag'] as Facet[]).forEach((facet) => {
        getSelectedValues(facet).forEach((value) => params.append(facet, value));
      });

      if (getTagMatchMode() === 'all') params.set('tag-match', 'all');

      const minRating = ratingMin?.value ?? '';
      const maxRating = ratingMax?.value ?? '';
      if (minRating) params.set('rating-min', minRating);
      if (maxRating) params.set('rating-max', maxRating);

      const search = params.toString();
      const url = `${window.location.pathname}${search ? `?${search}` : ''}${window.location.hash}`;
      window.history.replaceState(null, '', url);
    }

    function saveScrollPosition() {
      try {
        window.sessionStorage.setItem(scrollStorageKey, String(window.scrollY));
      } catch {
        // Scroll position is optional; ignore unavailable storage.
      }
    }

    function restoreScrollPosition() {
      if (scrollRestored) return;
      scrollRestored = true;
      try {
        const stored = window.sessionStorage.getItem(scrollStorageKey);
        if (stored) window.scrollTo(0, Number(stored) || 0);
        window.sessionStorage.removeItem(scrollStorageKey);
      } catch {
        // Scroll position is optional; ignore unavailable storage.
      }
    }

    function getSearchTokens(query: string) {
      const tokens: { field: SearchField | null; value: string }[] = [];
      query.toLowerCase().split(/\s+/).forEach((raw) => {
        if (!raw) return;
        const colon = raw.indexOf(':');
        if (colon > 0) {
          const key = raw.slice(0, colon);
          const value = raw.slice(colon + 1).trim();
          const field = fieldAliases[key];
          if (field && value) {
            tokens.push({ field, value });
            return;
          }
        }
        tokens.push({ field: null, value: raw });
      });
      return tokens;
    }

    function fieldText(question: Question, field: SearchField): string {
      switch (field) {
        case 'title':
          return question.title;
        case 'statement':
          return question.statement;
        case 'solution':
          return question.solution;
        case 'source':
          return question.sources.join(' ');
        case 'level':
          return question.levels.join(' ');
        case 'tag':
          return question.tags.join(' ');
        case 'difficulty':
          return question.difficulties.join(' ');
      }
    }

    function matchesKeywords(question: Question, query: string): boolean {
      const tokens = getSearchTokens(query);
      if (tokens.length === 0) return true;
      const scopes = scopeInputs
        .filter((input) => input.checked)
        .map((input) => input.dataset.scope as SearchField);
      return tokens.every((token) => {
        if (token.field) {
          return fieldText(question, token.field).toLowerCase().includes(token.value);
        }
        return scopes.some((scope) => fieldText(question, scope).toLowerCase().includes(token.value));
      });
    }

    function matchesFacet(questionValues: string[], selected: string[], mode: MatchMode): boolean {
      if (selected.length === 0) return true;
      return mode === 'all'
        ? selected.every((value) => questionValues.includes(value))
        : selected.some((value) => questionValues.includes(value));
    }

    function ratingNumber(value: string): number | null {
      return value.startsWith('*') ? Number(value.slice(1)) : null;
    }

    function matchesRatingRange(question: Question, minValue: string, maxValue: string): boolean {
      if (!minValue && !maxValue) return true;
      const ratings = question.difficulties
        .map(ratingNumber)
        .filter((value): value is number => value !== null && Number.isFinite(value));
      if (ratings.length === 0) return false;
      const min = minValue ? Number(minValue) : 0;
      const max = maxValue ? Number(maxValue) : Number.POSITIVE_INFINITY;
      return ratings.some((rating) => rating >= min && rating <= max);
    }

    function difficultyRank(question: Question): number {
      const ranks = question.difficulties
        .map((value) => difficultyOptions.indexOf(value))
        .filter((index) => index >= 0);
      return ranks.length > 0 ? Math.min(...ranks) : difficultyOptions.length;
    }

    function primarySource(question: Question): string {
      return question.sources[0] || '其他';
    }

    function compareQuestions(a: Question, b: Question, mode: SortMode): number {
      const newestFirst = String(b.created_at).localeCompare(String(a.created_at));
      switch (mode) {
        case 'oldest':
          return String(a.created_at).localeCompare(String(b.created_at));
        case 'difficulty-asc':
          return difficultyRank(a) - difficultyRank(b) || newestFirst;
        case 'difficulty-desc':
          return difficultyRank(b) - difficultyRank(a) || newestFirst;
        case 'source-asc':
          return primarySource(a).localeCompare(primarySource(b), 'zh-CN') || newestFirst;
        case 'source-desc':
          return primarySource(b).localeCompare(primarySource(a), 'zh-CN') || newestFirst;
        default:
          return newestFirst;
      }
    }

    function updateFacetSummaries() {
      (['source', 'difficulty', 'level', 'tag'] as Facet[]).forEach((facet) => {
        const selected = getSelectedValues(facet);
        const summary = document.querySelector<HTMLElement>(`[data-menu-summary="${facet}"]`);
        if (!summary) return;
        if (selected.length === 0) {
          summary.textContent = facetSummaryLabels[facet];
        } else if (selected.length <= 2) {
          summary.textContent = selected.join('、');
        } else {
          summary.textContent = `${selected[0]} 等 ${selected.length} 项`;
        }
      });
    }

    function filterMenuOptions(input: HTMLInputElement) {
      const facet = input.dataset.menuSearch;
      if (!facet) return;
      const query = input.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>(`[data-menu-options="${facet}"] .menu-chip`).forEach((chip) => {
        const text = chip.textContent?.toLowerCase() ?? '';
        chip.hidden = query !== '' && !text.includes(query);
      });
      document.querySelectorAll<HTMLElement>(`[data-menu-options="${facet}"] .menu-group`).forEach((group) => {
        const visibleChips = Array.from(group.querySelectorAll<HTMLElement>('.menu-chip')).filter(
          (chip) => !chip.hidden,
        );
        group.hidden = visibleChips.length === 0;
      });
    }

    function updateResults() {
      const query = searchInput?.value.trim() ?? '';
      const tagMode = getTagMatchMode();
      const sources = getSelectedValues('source');
      const difficulties = getSelectedValues('difficulty');
      const levels = getSelectedValues('level');
      const tags = getSelectedValues('tag');
      const minRating = ratingMin?.value ?? '';
      const maxRating = ratingMax?.value ?? '';
      const sortMode = (sortFilter?.value ?? 'newest') as SortMode;
      const visible = questions
        .filter((question) => (
          matchesKeywords(question, query) &&
          matchesFacet(question.sources, sources, 'any') &&
          matchesFacet(question.difficulties, difficulties, 'any') &&
          matchesFacet(question.levels, levels, 'any') &&
          matchesFacet(question.tags, tags, tagMode) &&
          matchesRatingRange(question, minRating, maxRating)
        ))
        .sort((a, b) => compareQuestions(a, b, sortMode));

      if (questionList) {
        questionList.replaceChildren(...visible.map(buildQuestionRow));
        questionList.hidden = visible.length === 0;
      }
      if (resultCount) resultCount.textContent = `共 ${visible.length} 道题`;
      if (emptyState) emptyState.hidden = visible.length !== 0;
      if (sortLabel) sortLabel.textContent = sortLabels[sortMode];
      syncUrlState();
    }

    async function loadQuestions() {
      if (loadError) loadError.hidden = true;
      if (resultCount) resultCount.textContent = '正在加载题目...';
      const { data, error } = await supabase
        .from('questions')
        .select('*')
        .eq('published', true)
        .order('created_at', { ascending: false })
        .returns<Question[]>();

      if (error) {
        if (questionList) questionList.hidden = true;
        if (emptyState) emptyState.hidden = true;
        if (loadError) loadError.hidden = false;
        if (resultCount) resultCount.textContent = '加载失败';
        return;
      }

      questions = (data ?? []).map((question) => ({
        ...question,
        solutionExcerptHtml: excerptHtml(question.solution),
      }));
      updateStats();
      updateResults();
      restoreScrollPosition();
    }

    function clearFilters() {
      window.clearTimeout(searchTimer);
      if (searchInput) searchInput.value = '';
      scopeInputs.forEach((input) => {
        input.checked = true;
      });
      facetInputs.forEach((input) => {
        input.checked = false;
      });
      tagMatchInputs.forEach((input) => {
        input.checked = input.value === 'any';
      });
      if (ratingMin) ratingMin.value = '';
      if (ratingMax) ratingMax.value = '';
      if (sortFilter) sortFilter.value = 'newest';
      menuSearchInputs.forEach((input) => {
        input.value = '';
        filterMenuOptions(input);
      });
      updateFacetSummaries();
      updateResults();
    }

    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(updateResults, 150);
    });
    sortFilter?.addEventListener('change', updateResults);
    scopeInputs.forEach((input) => input.addEventListener('change', updateResults));
    facetInputs.forEach((input) => input.addEventListener('change', () => {
      updateFacetSummaries();
      updateResults();
    }));
    tagMatchInputs.forEach((input) => input.addEventListener('change', updateResults));
    menuSearchInputs.forEach((input) => input.addEventListener('input', () => filterMenuOptions(input)));
    ratingMin?.addEventListener('change', updateResults);
    ratingMax?.addEventListener('change', updateResults);
    clearButton?.addEventListener('click', clearFilters);
    retryButton?.addEventListener('click', () => void loadQuestions());
    window.addEventListener('pagehide', saveScrollPosition);

    applyUrlState();
    updateFacetSummaries();
    void loadQuestions();
    supabase
      .channel('public-questions')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'questions' },
        () => void loadQuestions(),
      )
      .subscribe();
  </script>
</BaseLayout>
