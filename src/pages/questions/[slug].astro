---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  normalizeQuestionData,
  type RawQuestionData,
} from '../../lib/questions';
import { renderRichText } from '../../lib/markdown';
import { ArrowLeft, Calendar, ExternalLink } from '@lucide/astro';

type MarkdownModule = {
  frontmatter: RawQuestionData;
  Content: any;
};

export function getStaticPaths() {
  const modules = import.meta.glob<MarkdownModule>('/src/content/questions/*.md', {
    eager: true,
  });

  return Object.entries(modules).map(([path, module]) => ({
    params: { slug: path.split('/').pop()?.replace(/\.md$/, '') },
    props: { module },
  }));
}

const { module } = Astro.props as { module: MarkdownModule };
const { Content } = module;
const frontmatter = normalizeQuestionData(module.frontmatter);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(frontmatter.createdAt));
---

<BaseLayout
  title={`${frontmatter.title} · 算法题库`}
  description={frontmatter.statement || frontmatter.summary}
>
  <article class="detail-page">
    <a class="back-link" href={base}><ArrowLeft size={17} />返回题库</a>

    <header class="detail-header">
      <div class="detail-title-block">
        <div class="detail-kicker">
          <span>{frontmatter.source}</span>
          {frontmatter.sourceId && <span>#{frontmatter.sourceId}</span>}
        </div>
        <h1>{frontmatter.title}</h1>
      </div>
      {
        frontmatter.url && (
          <a class="outline-button" href={frontmatter.url} target="_blank" rel="noreferrer">
            查看原题 <ExternalLink size={16} />
          </a>
        )
      }
    </header>

    <div class="detail-metadata">
      <span class={`difficulty difficulty-${frontmatter.difficulty}`}>{frontmatter.difficulty}</span>
      <span><Calendar size={15} />{date}</span>
    </div>

    <div class="detail-tags">
      {frontmatter.levels.map((level) => <span class="level-chip">{level}</span>)}
      {frontmatter.categories.map((category) => <span class="category-chip">{category}</span>)}
      {frontmatter.tags.map((tag) => <span class="tag-chip">{tag}</span>)}
    </div>

    <div class="detail-content">
      {
        frontmatter.statement && (
          <section class="content-section">
            <h2>题意</h2>
            <div class="rich-text" set:html={renderRichText(frontmatter.statement)} />
          </section>
        )
      }
      {
        frontmatter.summary && (
          <section class="content-section">
            <h2>解题思路</h2>
            <div class="rich-text" set:html={renderRichText(frontmatter.summary)} />
          </section>
        )
      }
    </div>

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

